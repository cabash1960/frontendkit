{
  "name": "frontendkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:chrome": "cross-env TARGET=chrome tsc -b && cross-env TARGET=chrome vite build",
    "build:firefox": "cross-env TARGET=firefox tsc -b && cross-env TARGET=firefox vite build",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "run:firefox": "web-ext run --source-dir dist-firefox",
    "zip:firefox": "web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --overwrite-dest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "@tailwindcss/vite": "^4.1.18",
    "frontendkit": ".",
    "lucide-react": "^0.562.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-helmet-async": "^3.0.0",
    "react-router": "^7.12.0",
    "react-router-dom": "^7.12.0",
    "react-spinners": "^0.17.0",
    "react-toastify": "^11.1.0",
    "swr": "^2.3.8",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "web-ext": "^10.8.0"
  }
}
